FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY loom/ /app/loom/
RUN cd /app/loom && uv sync --no-dev

COPY baft/pyproject.toml baft/uv.lock /app/baft/
COPY baft/src/ /app/baft/src/
COPY baft/configs/ /app/baft/configs/
RUN cd /app/baft && uv sync --no-dev

WORKDIR /app/baft

ENTRYPOINT ["uv", "run", "loom", "router"]
