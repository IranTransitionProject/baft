FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY heddle/ /app/heddle/
RUN cd /app/heddle && uv sync --no-dev --extra duckdb

COPY baft/pyproject.toml baft/uv.lock /app/baft/
COPY baft/src/ /app/baft/src/
COPY baft/pipeline/ /app/baft/pipeline/
RUN cd /app/baft && uv sync --no-dev

WORKDIR /app/baft

ENTRYPOINT ["uv", "run", "python", "pipeline/scripts/itp_import_to_duckdb.py"]
